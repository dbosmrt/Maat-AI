# =============================================================================
# MAAT-AI Environment Variables Template
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - API Authentication
# -----------------------------------------------------------------------------
# API key for backend authentication (must match frontend VITE_API_KEY)
# Generate a secure random key: openssl rand -hex 32
MAAT_API_KEY=your-secure-random-api-key-here

# -----------------------------------------------------------------------------
# REQUIRED - NVIDIA NIM (NVIDIA Inference Microservices)
# -----------------------------------------------------------------------------
# Get your API key from: https://build.nvidia.com/
NVIDIA_NIM_KEY=your-nvidia-nim-api-key-here

# -----------------------------------------------------------------------------
# REQUIRED - Pinecone Vector Database
# -----------------------------------------------------------------------------
# Get your API key from: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here
# Pinecone index name for embeddings
PINECONE_INDEX_NAME=maat 법률
# Pinecone environment/region (e.g., "us-east-1", "gcp-starter")
PINECONE_ENVIRONMENT=your-pinecone-environment

# -----------------------------------------------------------------------------
# OPTIONAL - CORS Configuration (comma-separated origins)
# -----------------------------------------------------------------------------
# Default: http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
# Production example: https://your-frontend-domain.com,https://staging.your-frontend.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# OPTIONAL - Application Settings
# -----------------------------------------------------------------------------
# Environment: "dev" or "server" (affects logging format)
ENVIRONMENT=dev
# Port for the API server
PORT=8000
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# OPTIONAL - Embedding Configuration
# -----------------------------------------------------------------------------
# Embedding model batch size (default: 16)
EMBEDDING_BATCH_SIZE=16
# Embedding model name (uses NVIDIA Nemotron Embed)
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# -----------------------------------------------------------------------------
# FRONTEND (Vite) - Copy to app/.env.local or set in deployment
# -----------------------------------------------------------------------------
# VITE_API_BASE=http://localhost:8000
# VITE_API_KEY=your-secure-random-api-key-here (must match MAAT_API_KEY)