
# MA'AT LEGAL AI - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the required values



# APPLICATION

APP_NAME="Ma'at Legal AI"
APP_VERSION=1.0.0
ENVIRONMENT=development


# SECURITY (REQUIRED - NO DEFAULTS)

# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-256-bit-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Optional: Fernet encryption key for sensitive data at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=


# DATABASE

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=maat_ai


# REDIS (for rate limiting, sessions, caching)

REDIS_URI=redis://localhost:6379


# CORS

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# RATE LIMITING

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1minute

# Auth endpoints stricter limits
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW=1minute


# NVIDIA NIM (REQUIRED)

NVIDIA_NIM_KEY=your-nvidia-nim-api-key

# Model defaults (can be overridden per-user in settings)
CHAT_MODEL_NEMOTRON3SUPER=nvidia/llama-3.3-nemotron-super-49b-v1
CHAT_MODEL_GLM5_2=z-ai/glm-5.2
CHAT_MODEL_SARVAM_M=sarvamai/sarvam-m
CHAT_MODEL_MINIMAX_M3=minimaxai/minimax-m3
CHAT_MODEL_NEMOTRON_ULTRA=nvidia/nemotron-3-ultra
CHAT_MODEL_LLAMA3_1_70B=meta/llama-3.1-70b-instruct
CHAT_TEMPERATURE=0.6
CHAT_TOP_P=0.95
CHAT_MAX_TOKENS=8192


# PINECONE VECTOR DATABASE (REQUIRED)

PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=legal-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIM=1024
PINECONE_METRIC=cosine


# OPTIONAL - WEB SEARCH

DDGS_REGION=in-en
DDGS_MAX_RESULTS=3


# OPTIONAL - QUERY PROCESSING

QUERY_SUMMARIZE_THRESHOLD=120
MAX_HISTORY_TOKENS=4000


# OPTIONAL - LANGSMITH OBSERVABILITY (RECOMMENDED FOR PROD)

LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=maat-legal-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false


# LOGGING
LOG_LEVEL=INFO
LOG_FORMAT=json