# =============================================================================
# MAAT-AI Frontend Environment Variables (Vite)
# Copy this file to app/.env.local and fill in your values
# =============================================================================

# API Configuration
# Use http://127.0.0.1:8000 instead of localhost for some CORS setups
VITE_API_BASE=http://localhost:8000

# API Key - MUST match the MAAT_API_KEY set in the backend .env file
# Generate a secure key: openssl rand -hex 32
VITE_API_KEY=your-secure-random-api-key-here

# =============================================================================
# OPTIONAL - Web Search Configuration (DDGS)
# =============================================================================
# Region for DuckDuckGo search (e.g., in-en, us-en, uk-en)
# DDGS_REGION=in-en
# Maximum results per search query (default: 3)
# DDGS_MAX_RESULTS=3

# =============================================================================
# OPTIONAL - Advanced Frontend Settings
# =============================================================================
# Request timeout in milliseconds (default: 30000 = 30 seconds)
# VITE_REQUEST_TIMEOUT=30000

# =============================================================================
# OPTIONAL - Advanced Backend Settings (passed via API env)
# =============================================================================
# MAX_HISTORY_TOKENS=4000
# PINECONE_DIM=1024
# PINECONE_METRIC=cosine
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# QUERY_SUMMARIZE_THRESHOLD=120